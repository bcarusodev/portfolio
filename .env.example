# ── AI chat agent (portfolio assistant) ──────────────────────────────
# Feature flag: "true" shows the chat widget on the Home page (FR-27).
NEXT_PUBLIC_AI_CHAT_ENABLED=true

# Provider key used by getProvider(): groq | cerebras | openai (FR-25).
NEXT_PUBLIC_AI_PROVIDER=groq

# Server-only credential — NEVER expose with a NEXT_PUBLIC_ prefix (FR-26).
# Groq (free tier, no card): https://console.groq.com/keys
AI_PROVIDER_API_KEY=

# Optional server-only override of the provider base URL (OpenAI-compatible
# proxies, or a local mock during development). Defaults to the provider's
# official URL.
# AI_PROVIDER_BASE_URL=

# Model override. Defaults: openai/gpt-oss-120b (groq), qwen-3-32b (cerebras),
# gpt-4o-mini (openai). NOTE: Groq model IDs require the vendor namespace prefix.
AI_MODEL=openai/gpt-oss-120b

# Reasoning effort (low | medium | high) for gpt-oss models. Groq defaults to
# low here: reasoning tokens come out of max_completion_tokens and count
# against the free-tier token budget. Any other value omits the parameter.
# AI_REASONING_EFFORT=low

# ── Free-tier budget (Groq gpt-oss: 30 RPM / 1K RPD / 8K TPM / 200K TPD) ──
# Per-request KB retrieval budget. The request also pays for the instruction
# block, the history, and the completion, so this is deliberately small.
AI_MAX_KB_TOKENS=2500

# Headings pinned to every request so greetings still get identity context.
# Comma-separated `##` or `###` titles. An empty value disables the core.
AI_KB_CORE_SECTIONS=Identity,Elevator Pitch,Current Role

# Completion cap, reasoning tokens included. It must sit ABOVE the natural
# answer length: at 480 a measured answer came back with finish_reason
# "length" at exactly 480 completion tokens, and measured completions run
# 313-536. How the cap is accounted against the TPM window is not established,
# so size it from the answer distribution: a continuation re-sends the whole
# prompt and costs far more than a larger cap.
AI_MAX_COMPLETION_TOKENS=1000

# Extra upstream calls allowed when an answer hits that cap. The partial answer
# is appended as an assistant turn and the model resumes from where it stopped,
# so the visitor sees one continuous reply. 0 disables it and reports the
# truncation instead. Each continuation is a real request against RPD/TPM.
# AI_CONTINUATIONS_MAX=1

# Answer cache: a repeated history-less question is answered from memory and
# costs zero upstream tokens. Entries live in the process (reset on redeploy).
# AI_ANSWER_CACHE_MAX=50   # 0 disables the cache
# AI_ANSWER_CACHE_TTL_MS=900000

# Retry once after an upstream 429, but only when its `retry-after` is at most
# this long. 0 disables the retry (fail fast with the upstream hint instead).
# AI_RETRY_MAX_WAIT_MS=6000

# In-memory per-IP rate limiter (defaults match the Groq free tier: 30 RPM).
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=60000

# Per-IP daily cap (fixed 24h window per IP). Set to 0 to disable.
AI_RATE_LIMIT_DAILY_MAX=60

# Global in-process arrival cap (requests per minute across all IPs).
# Set to 0 to disable.
AI_GLOBAL_RATE_LIMIT_MAX=120
